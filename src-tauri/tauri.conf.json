{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "库存雷达",
  "version": "0.6.0",
  "identifier": "local.dingdingguo.stockradar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "库存雷达",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 660
      },
      {
        "label": "tray",
        "title": "库存雷达 · 菜单栏",
        "url": "index.html?view=tray",
        "width": 390,
        "height": 550,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
