{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "isolatedModules": true
  },
  "include": ["src"]
}
